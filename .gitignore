# ============================================================================
# .gitignore — recon（纯本地物体 3D 扫描建模内核）
#
# 原则：
#   1) 只忽略「可再生成」的产物与「本机/IDE 私有」文件；
#   2) 源码、文档、CMake、工具脚本、第三方 vendor 源一律入库；
#   3) third_party/ 下被 cmake/ThirdParty.cmake 登记的支持目录
#      （PoissonRecon-master/，其 ZLIB 子目录被 CMake 实际引用）
#      绝不能整目录忽略 —— 否则 CI 构建断链。
# ============================================================================

# ---------------------------------------------------------------------------
# 构建目录（本机多个、按用途命名；一律不入库）
# ---------------------------------------------------------------------------
/build/
/build_cmake/
/build_dbg/
/build_verify_desktop/
/build_*/
cmake-build-*/
out/
dist/
# CI 产物下载暂存目录（IPA / xcframework / metallib；按精确目录名排除，
# 不用通配以免误伤登记闸门锚定的文件）。
/dist_ci/

# ---------------------------------------------------------------------------
# 构建中间产物 / 二进制
# ---------------------------------------------------------------------------
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app/
*.dSYM/
*.pdb
*.ilk
*.exp
*.gcda
*.gcno
*.gcov
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Makefile
!docs/Makefile

# ---------------------------------------------------------------------------
# 测试运行时产物（tests/unit/test_pipeline.cpp 的写出路径，可再生成）
#   ⚠️ 只按「精确文件名」忽略，不做 *.glb/*.ply 全局通配 ——
#      否则将来新增的模型夹具会被静默排除。
# ---------------------------------------------------------------------------
/test_pipeline_model.glb
/test_pipeline_model.ply

# 手工用 glslangValidator 探活时留下的默认输出名（形如 `comp <file>.comp.spv`）。
# 它既非源码也非登记的产物（正式产物在 build/vulkan/spirv/，已被上方 /build/ 覆盖），
# 出现在工作区纯属噪声，且**两次**混进过待提交列表。故按精确名忽略；
# 不写 *.spv —— 那会连将来有意入库的夹具也一起吃掉。
/comp.spv
/*.comp.spv

# ---------------------------------------------------------------------------
# iOS / Xcode / Metal（.xcodeproj 由 XcodeGen 在 macOS 上生成，属 CI 产物）
# ---------------------------------------------------------------------------
*.xcodeproj/
*.xcworkspace/
*.xcframework/
xcuserdata/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.air
*.metallib
!shaders/**/*.metal
*.xccheckout
*.xcscmblueprint

# ---------------------------------------------------------------------------
# Android / Gradle / NDK
# ---------------------------------------------------------------------------
.gradle/
local.properties
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
!platform/android/**/gradle-wrapper.jar
jniLibs/
obj/
.cxx/

# ---------------------------------------------------------------------------
# 第三方上游原始下载包（保留在磁盘以备复现；体积大，不入库）
#   ⚠️ 只忽略 zip 文件本身，不忽略任何目录。
#      third_party/PoissonRecon-master/ 是登记的支持目录（含被引用的 ZLIB），
#      third_party/poisson_recon/ 与 third_party/xatlas/ 是 vendor 源码。
# ---------------------------------------------------------------------------
third_party/*.zip
third_party/*.tar.gz
third_party/*.tgz
third_party/*.7z

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# 编辑器 / IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.clangd/
.cache/

# ---------------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# WorkBuddy / AI 助手工作数据（本地开发过程产物，非源码交付物）
#   本目录是项目记忆（非缓存，请勿删除），但不属于对外交付内容。
# ---------------------------------------------------------------------------
.workbuddy/
