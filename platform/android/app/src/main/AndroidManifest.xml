<!--
  AndroidManifest.xml — 权限与特性声明。
  契约：docs/11_平台权限与集成.md §2.1（决策总表）、§2.2（本片段逐字对齐）。

  零网络是硬约束：INTERNET / ACCESS_NETWORK_STATE 明确不声明。
  最小权限：不声明 RECORD_AUDIO / READ_MEDIA_* / ACCESS_*_LOCATION。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- ========== 权限 ========== -->
    <!-- 必需：相机 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 仅 API <= 28 写公共目录需要；API 29+ 走分区存储（docs/11 §2.4） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="28" />

    <!-- 长时重建的前台服务（dataSync 类型，docs/11 §2.5） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- POST_NOTIFICATIONS 只在用户启动长时重建时运行时申请，见 MainActivity -->

    <!-- 明确不声明：INTERNET / ACCESS_NETWORK_STATE（零网络） -->
    <!-- 明确不声明：RECORD_AUDIO / READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE -->
    <!-- 明确不声明：ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION -->

    <!-- ========== 特性 ========== -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.camera.depth" android:required="false" />
    <uses-feature android:name="com.google.ar.core" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".ReconApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="false"
        tools:targetApi="34">

        <!-- ARCore 为可选依赖：未安装/未认证时走 BRANCH_MONO -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />
        <meta-data android:name="com.google.ar.core.minimum" android:value="1.40" />

        <!-- 剔除 CameraX 传递引入的 Apache HttpClient（零网络审查口径，docs/11 §2.2） -->
        <uses-library android:name="org.apache.http.legacy"
                      android:required="false" tools:node="remove" />

        <!-- 采集 Activity：锁竖屏（docs/11 §4.2 配置变更） -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 重建前台服务（dataSync 类型） -->
        <service
            android:name=".ReconstructionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
