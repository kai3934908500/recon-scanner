<!--
  res/values/themes.xml — 应用主题。

  为什么用 Theme.DeviceDefault.* 而不是 Theme.MaterialComponents.* / AppCompat：
    本项目**不依赖** appcompat 或 material 组件库（见 app/build.gradle 的
    dependencies —— 零网络 + 最小体积，且 UI 由自绘/Compose 承载）。
    Theme.DeviceDefault.* 是**框架自带**主题，无需任何 AAR 依赖即可用；
    而 android:Theme.Material.Light.NoActionBar 亦在框架内。
    若在此引用 Theme.AppCompat.* 会要求 appcompat 依赖，一旦遗漏即
    资源链接期报 `resource style/Theme.AppCompat... not found`。

  windowLightStatusBar 需要 API 23+（minSdk 24 已满足），无需 values-v23 覆盖。
-->
<resources>

    <!-- 采集活动是全屏取景：不显示 ActionBar -->
    <style name="Theme.Recon" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
